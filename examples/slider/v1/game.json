{
    "game": {
        "title": "Parliament Learning Module - Manhattan",
        "containerAspectRatio": 0.49793103,
        "mobileSize": 320,
        "tabletSize": 768,
        "desktopSize": 1024,
        "resizeDebounce": 100,
        "fadeDuration": 300,
        "defaultScaleDuration": 500,
        "preloadImages": true,
        "requires": [{"module": "emit", "version": "0.1.16", "verbosity": "console"}, {"module": "slider", "version": "0.1.16"}],
        "requiredCoreVersion": "0.1.16",
        "useCDN": true,
        "pageBackground": [
            { "type": "colour", "variant": "hex", "target": "all", "value": "000000" }
        ],
        "containerBackground": [
            { "type": "image", "variant": "local", "target": "all", "value": "images/Red_mondule_landing-page_Background.webp" }
        ]
    },
    "scenes": [
        {
            "name": "landing",
            "initial": true,
            "background": [
                { "type": "image", "variant": "local", "target": "all", "value": "images/Red_mondule_landing-page_Background.webp" }
            ],        
            "containerBackground": [
                { "type": "image", "variant": "local", "target": "all", "value": "images/Red_mondule_landing-page_Background.webp" }
            ],                
            "elements": [
                { "id": "container1", "type": "container", "variant": "vflex", "elements": [
                    { "id": "landing1", "type": "picture", "location": "local", "url": "images/Red_mondule_landing-page_Logo.webp", "y": 10, "x": 50, "clickable": false, "aspectRatio": "314/172", "width": "50%" },
                    { "id": "landing2", "type": "picture", "location": "local", "url": "images/Red_mondule_landing-page_Text.webp", "y": 44, "x": 51, "clickable": false, "aspectRatio": "572/748", "width": "65%" },
                    { "id": "landing3", "type": "picture", "location": "local", "url": "images/Red_mondule_landing-page_Button.webp", "y": 75, "x": 50, "clickable": true, "aspectRatio": "342/108", "width": "50%",  "clickActions":[
                        { "action": "scale", "target": "self", "value": "0.9", "duration": 250 },
                        { "action": "navigate", "target": "scene", "value": "main_slider" }
                    ] },
                    { "id": "landing4", "type": "picture", "location": "local", "url": "images/Red_mondule_landing-page_Text2.webp", "y": 90, "x": 50, "clickable": false, "aspectRatio": "210/94", "width": "50%"}
                ] }
            ]
        },  

        {
            "name": "main_slider",
            "elements": [
                { "id": "container1", "type": "container", "variant": "vflex", "elements": [
                    { "id": "slider1", "type": "slider", "x": 50, "y": 50, "width": "100%", "height": "100%", "config": {
                        "slides": [
                            {
                                "background": [{"type": "image", "variant": "local", "value": "images/Red_mondule_game_BronzeBG.webp"}],                                                        
                                "elements": [
                                    {"id": "slide1_text", "type": "picture", "location": "local", "url": "images/Red_mondule_game_slider.webp", "y": 55, "x": 75, "aspectRatio": "228/228", "width": "30%", "clickable": true, "clickActions": 
                                    [
                                        {"action": "slide", "target": "slider1", "value": 1}
                                    ]},
                                    { "id": "select_image_1", "type": "picture", "location": "local", "url": "images/Red_mondule_game_text1.webp", "y": 75, "x": 50, "clickable": true, "aspectRatio": "746/306", "width": "100%"},
                                    { "id": "select_button_1", "type": "picture", "location": "local", "url": "images/Red_Module_Game_Button.webp", "y": 93, "x": 50, "clickable": true, "aspectRatio": "370/103", "width": "50%",  "clickActions":[
                                        { "action": "scale", "target": "self", "value": "0.9", "duration": 250 },
                                        { "action": "navigate", "target": "scene", "value": "outcome_success" }
                                    ] }                                    
                                ]
                            },
                            {
                                "background": [{"type": "image", "variant": "local", "value": "images/Red_mondule_game_RedBG.webp"}],                                                        
                                "elements": [
                                    {"id": "slide2_text", "type": "picture", "location": "local", "url": "images/chevron_right.png", "y": 55, "x": 8, "aspectRatio": "114/228", "width": "15%", "clickable": true, "clickActions": 
                                    [
                                        {"action": "slide", "target": "slider1", "value": 0}
                                    ]},
                                    { "id": "select_image_2", "type": "picture", "location": "local", "url": "images/Red_mondule_game_text2.webp", "y": 37, "x": 50, "clickable": true, "aspectRatio": "662/372", "width": "85%"},
                                    { "id": "select_button_2", "type": "picture", "location": "local", "url": "images/Red_Module_Game_Button.webp", "y": 93, "x": 50, "clickable": true, "aspectRatio": "370/103", "width": "50%",  "clickActions":[
                                        { "action": "scale", "target": "self", "value": "0.9", "duration": 250 },
                                        { "action": "navigate", "target": "scene", "value": "outcome_success" }
                                    ] }                                             
                                ]
                            }
                        ],
                        "transitionDuration": 500,
                        "showIndicators": false,
                        "showArrows": false,
                        "loop": true,
                        "resetOnSceneEnter": true
                    }},
                    { "id": "slider_overlay", "type": "picture", "location": "local", "url": "images/Red_mondule_game_header.webp", "y": 12, "x": 50, "clickable": false, "aspectRatio": "750/362", "width": "100%"}
                ] }
            ]
        },         
        {
            "name": "outcome_success",
            "containerBackground": [
                { "type": "image", "variant": "local", "target": "all", "value": "images/Red_mondule_landing-page_Background.webp" }
            ],
            "elements": [
                { "id": "outcome_container", "type": "container", "variant": "vflex", "elements": [
                    { "id": "outcome_image_1", "type": "picture", "location": "local", "url": "images/Red_Module_End_Text.webp", "y": 21, "x": 50, "clickable": false, "aspectRatio": "598/669", "width": "80%" },
                    { "id": "outcome_button", "type": "picture", "location": "local", "url": "images/Red_Quiz_End_Win_Button.webp", "y": 45, "x": 50, "clickable": true, "aspectRatio": "401/119", "width": "50%",  "clickActions":[
                        { "action": "scale", "target": "self", "value": "0.9", "duration": 250 },
                        { "action": "navigate", "target": "scene", "value": "landing" }
                    ] },                    
                    { "id": "outcome_image_2", "type": "picture", "location": "local", "url": "images/Red_Module_End_Image.webp", "y": 72, "x": 50, "clickable": false, "aspectRatio": "750/972", "width": "95%" }
                ]}
            ]
        }       
    ]
}